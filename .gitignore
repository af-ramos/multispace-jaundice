# Publication/reproducibility trees; all other root entries are local-only.
/*
!/.gitignore
!/LICENSE
!/LICENSE-DATA
!/README.md
!/requirements.txt
!/requirements-train.lock
!/requirements-test.txt
!/paper/
!/src/
!/analysis/
!/scripts/
!/tests/
!/docs/
!/release/
!/results/
!/evidence/
!/splits/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
*.log
*.aux
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.pt
*.pth
*.db
.cache_roi/
/paper/*
!/paper/paper.tex
!/paper/paper.pdf
!/paper/references.bib
!/paper/sn-jnl.cls
!/paper/sn-mathphys-num.bst
!/paper/figs/
/docs/*
!/docs/REPRODUCIBILITY.md
!/docs/ARTIFACTS.md
/release/*
!/release/profiles.json
!/release/source_provenance.json
/results/*
!/results/G1_gate_weights.csv
!/results/G2_attribution_shift.csv
!/results/G3_gate_per_image.csv
!/results/H0_alavancas.csv
!/results/fusion_block_audit.json
!/results/pre_submission_statistics.json
!/results/equal_cost_control.csv
!/results/equal_cost_control.json
!/results/crop_audit.csv
!/results/crop_audit_summary.json
/evidence/*
!/evidence/v7/
!/evidence/v7_reseed/
/evidence/v7/*
!/evidence/v7/aggregate.csv
!/evidence/v7/A1_factorial_accf1.csv
!/evidence/v7/prediction_provenance.json
!/evidence/v7/best_params/
!/evidence/v7/markers/
!/evidence/v7/preds/
!/evidence/v7/stats/
